# ---------------------------------------------------------------
# Snake & Ladder Promo - environment variables
# Copy to .env.local for local development.
# If the SUPABASE_* values are empty the app runs on a local
# in-memory store (single process, great for trying it out; NOT for Vercel).
# ---------------------------------------------------------------

# Public URL of the deployed app (used for share links / QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard login
ADMIN_PASSWORD=change-me-please
# Long random string used to sign admin sessions and hash player tokens
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace-with-a-long-random-string
